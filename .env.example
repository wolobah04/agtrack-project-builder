# Public Appwrite browser configuration (safe to expose)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6b011308003b57f341b6

# Permanent public site used in buyer QR codes (never use a private preview URL)
VITE_PUBLIC_APP_URL=https://agtrack.online

# Server-only configuration used by TanStack server functions and the setup script
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6b011308003b57f341b6
APPWRITE_API_KEY=replace_with_a_server_api_key
APPWRITE_DATABASE_ID=agtrack

# Optional: create the first Ministry admin when running bun run appwrite:setup
# Passwords must contain at least 8 characters. Do not commit real values.
APPWRITE_ADMIN_NAME=Ministry Admin
APPWRITE_ADMIN_PHONE=+231770000003
APPWRITE_ADMIN_PASSWORD=

# Server-only Groq key for the AI farm assistant (never expose it to the browser)
GROQ_API_KEY=replace_with_a_groq_api_key
